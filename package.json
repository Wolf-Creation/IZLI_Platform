{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "pnpm --dir src/apps/api dev",
    "dev:admin": "vite --host 0.0.0.0 --mode admin",
    "dev:admin:render": "vite --host 0.0.0.0 --port 8446 --mode admin-render",
    "dev:website": "vite --host 0.0.0.0 --mode website",
    "dev:website:render": "vite --host 0.0.0.0 --port 8445 --mode website-render",
    "build": "vite build --mode production",
    "check:api": "node --check src/apps/api/start.js && node --check src/apps/api/src/app.js",
    "build:admin": "vite build --mode admin",
    "build:website": "vite build --mode website",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "nodemailer": "^10.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "sass": "^1.102.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
